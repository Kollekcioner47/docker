# docker-course: insecure-example
#
# ЭТО НАГЛЯДНОЕ ПОСОБИЕ, А НЕ ОБРАЗЕЦ ДЛЯ КОПИРОВАНИЯ.
# Практика 10 разбирает этот файл построчно и показывает, что именно
# здесь не так: большой базовый образ, компиляторы в финальном образе,
# работа от root, пароль внутри образа. Собирается он ровно для того,
# чтобы сравнить результат со сканером уязвимостей и на живом примере
# увидеть, чем защищённый вариант отличается от обычного.
#
# Сборка для сравнения:
#   docker build -f Dockerfile.insecure -t p10-insecure:1.0 .

# Базовый образ — полный Ubuntu. Он больше минимального собрата
# примерно на сто мегабайт, и почти всё это — пакеты, которые
# приложению не нужны, но по которым сканер считает уязвимости.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ENV APP_VERSION=1.0

# Токен прямо в образе. Так делать нельзя: ENV виден в docker inspect,
# в docker history и в /proc/1/environ внутри контейнера, а также
# остаётся в слое навсегда — даже если следующей инструкцией его убрать.
ENV API_TOKEN=SuperSecretToken123

WORKDIR /opt/app

# apt-get update и установка в одной инструкции — единственное, что
# здесь сделано правильно. А вот очистки /var/lib/apt/lists/* нет:
# списки пакетов останутся в образе навсегда и добавят к нему
# несколько десятков мегабайт.
#
# Компиляторы и git нужны только на время сборки, но остаются
# в финальном образе: gcc, make и заголовочные файлы — это ещё
# и удобная среда для того, кто получит доступ внутрь контейнера.
RUN apt-get update && apt-get install -y \
        python3 \
        python3-pip \
        gcc \
        make \
        git \
        curl \
        vim \
        netcat-openbsd

# ADD вместо COPY. Для локального файла разницы нет, но ADD умеет
# скачивать по ссылке и распаковывать архивы — то есть делает неявную
# работу, которую в сборке никто не ожидает.
ADD app/app.py /opt/app/app.py

# COPY всего каталога. В образ уезжает всё, что лежит в контексте
# сборки: сам Dockerfile.insecure, скрипты, а в реальном проекте —
# ещё и .git, тесты и файл .env с настоящими значениями.
COPY . /opt/app/

EXPOSE 8080

# Инструкции USER нет — значит, процесс работает от root.
# Внутри контейнера это root без ограничений: он может писать в любой
# каталог образа и, при неудачной конфигурации, в примонтированные
# каталоги хоста. HEALTHCHECK тоже нет: Docker считает живым любой
# процесс, который ещё не завершился.

CMD ["python3", "/opt/app/app.py"]
