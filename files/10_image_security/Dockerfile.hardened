# Защищённый образ для практики 10. Антипод — Dockerfile.insecure.
#
# Что здесь сделано и почему:
#   * базовый образ закреплён по тегу и взят минимальным (slim, а не ubuntu);
#   * сборка двухэтапная: всё, что нужно только для сборки, в финальный
#     образ не уезжает;
#   * из финального образа удалён установщик пакетов pip: приложению он
#     не нужен, а каждый лишний пакет — это лишние уязвимости;
#   * контейнер работает от непривилегированного пользователя с явными
#     uid и gid, а не от root;
#   * есть HEALTHCHECK: без него Docker не отличает «работает» от
#     «процесс ещё жив».

# ---------------------------------------------------------------- стадия 1
# Стадия сборки. Здесь есть установщик пакетов и инструменты базового
# образа — и ни один файл этой стадии в финальный образ не попадает,
# кроме подготовленного приложения.
FROM python:3.13-slim AS builder

WORKDIR /build

# Копируем только то, что нужно сборке. Копирование всего каталога
# (COPY . .) затянуло бы в образ и лишние файлы, и сбросило кэш слоёв
# при любой правке в каталоге.
COPY app/app.py ./

# Компилируем байт-код заранее, на стадии сборки. Тогда в финальном
# образе не нужны права на запись в каталог приложения: интерпретатор
# не пытается создать __pycache__ при первом запуске и не падает
# на файловой системе, смонтированной только для чтения.
RUN python -m compileall -q app.py

# ---------------------------------------------------------------- стадия 2
# То, что поедет на стенд. Тот же базовый образ, но без инструментов
# сборки и без установщика пакетов.
FROM python:3.13-slim AS runtime

LABEL org.opencontainers.image.title="docker-course-p10-hardened" \
      org.opencontainers.image.description="Учебный защищённый образ: непривилегированный пользователь, минимальный базовый образ" \
      org.opencontainers.image.authors="Иван Климарев" \
      org.opencontainers.image.licenses="MIT"

# PYTHONDONTWRITEBYTECODE — не создавать .pyc на лету (байт-код уже собран).
# PYTHONUNBUFFERED — не буферизовать вывод: иначе journal контейнера
# при аварии окажется пустым, и разбирать будет нечего.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    APP_VERSION=1.0

WORKDIR /app

# Из стадии сборки забираем ровно два пути.
COPY --from=builder /build/app.py /app/app.py
COPY --from=builder /build/__pycache__ /app/__pycache__

# Удаляем установщик пакетов, разворачивание окружения и лишние
# инструменты. Смысл не в размере, а в поверхности атаки: pip со своими
# зависимостями — это десятки пакетов, по которым сканер находит
# уязвимости, а приложению они не нужны.
#
# Здесь же создаётся пользователь с фиксированными uid и gid. Фиксируем
# их намеренно: если uid «назначит» Docker, он будет разным на разных
# сборках, и права на примонтированных томах разъедутся.
RUN rm -rf /usr/local/lib/python3.13/site-packages/pip \
           /usr/local/lib/python3.13/site-packages/pip-*.dist-info \
           /usr/local/lib/python3.13/ensurepip \
           /root/.cache \
    && rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.13 \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --no-create-home \
               --shell /usr/sbin/nologin app

# Всё, что ниже, выполняется уже не от root. Порядок важен: инструкции
# до USER выполняются с правами root, поэтому пользователь создаётся
# выше, а запуск процесса — ниже.
USER 10001:10001

# EXPOSE ничего не публикует: это только документация о том, какой порт
# слушает приложение. Публикация делается флагом -p при запуске.
EXPOSE 8080

# Проверка работоспособности. Питон внутри образа есть, а curl и wget
# в минимальный образ не установлены — поэтому проверяем на самом
# интерпретаторе, не добавляя в образ ничего нового.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('PORT', '8080') + '/healthz', timeout=2)"]

# exec-форма: процесс получает сигналы напрямую, docker stop работает
# предсказуемо, а не через промежуточный shell.
ENTRYPOINT ["python", "/app/app.py"]
