# docker-course: insecure-example
#
# ПРИМЕР ТОГО, КАК ДЕЛАТЬ НЕЛЬЗЯ. Наглядное пособие к практике 9,
# а не образец для копирования: значения здесь учебные.
#
# Секрет попадает в образ двумя способами, и оба плохи:
#
#   ENV DB_PASSWORD   — значение становится частью метаданных образа
#                       и остаётся в нём навсегда: образ уже разошёлся
#                       по машинам, «отозвать» его нельзя, можно
#                       только сменить сам пароль;
#   ARG API_TOKEN     — в конфигурацию контейнера не попадает, но
#                       остаётся в записи о сборке, которую BuildKit
#                       прикладывает к образу.
#
# Проверить (имя файла — не Dockerfile, поэтому нужен -f):
#     docker build -f Dockerfile.bad -t p9-leaky .
#     docker history --no-trunc p9-leaky
#
# Пометка в первой строке отключает для этого файла только проверку
# на секреты открытым текстом (tools/validate_files.py). Остальные
# правила Dockerfile соблюдены намеренно: так видно, что небезопасной
# бывает не «плохо написанная сборка», а одна строка в хорошей.

FROM alpine:3.24

# Способ первый: секрет в ENV. Значение печатает docker history.
ENV DB_PASSWORD=mysecretpass

# Способ второй: секрет в ARG. Значение тоже печатает docker history.
ARG API_TOKEN=token-0123456789abcdef

WORKDIR /opt/app

RUN adduser -D -u 10001 app

USER app

# Контейнер остаётся жив: в него заходят и смотрят, что видно снаружи.
CMD ["sh", "-c", "exec sleep 300"]
